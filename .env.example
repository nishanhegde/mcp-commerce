# Copy to .env (gitignored). Loaded by server.py and the demo client.
MCP_TRANSPORT=stdio        # stdio | http
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_API_KEY=change-me      # required when MCP_TRANSPORT=http; clients send it as a Bearer token

# OCC backend. Leave OCC_BASE_URL unset to use the built-in mock (mock_occ/).
# OCC_BASE_URL=https://localhost:9002
OCC_BASE_SITE=shop
