# Copy to .env in the repo root (gitignored). Read only from there, never from
# the working directory; values already in the environment (a client's "env"
# block, the shell) win over it.
# Check what the server would run with:  uv run mcp-commerce --check-config

# --- MCP server ---
MCP_TRANSPORT=stdio        # stdio | http
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_API_KEY=change-me      # required for http; clients send it as a Bearer token. The placeholder counts as unset.

# --- OCC backend ---
OCC_MODE=mock              # mock: built-in mock_occ, no setup | live: a real SAP Commerce at OCC_BASE_URL
# OCC_BASE_URL=https://localhost:9002   # live only. Host root: the client adds /occ/v2/{site}
OCC_BASE_SITE=shop
# OCC_USER_PATH=users/current           # users/current (B2C) | orgUsers/current (B2B)
# OAuth client (live only). With OCC_USERNAME and OCC_PASSWORD it's the
# password grant (a customer token, needed by cart and order tools); without
# them, client_credentials (catalog tools only).
# OCC_CLIENT_ID=mobile_android
# OCC_CLIENT_SECRET=secret
# OCC_USERNAME=customer@example.com
# OCC_PASSWORD=...
# OCC_CA_BUNDLE=/path/to/ca.pem         # trust a self-signed dev cert (local :9002) without disabling TLS checks

# --- Demo agent (examples/demo.py) only; the server itself never calls the model ---
ANTHROPIC_API_KEY=sk-ant-...
